MONGODB_URI=your_mongodb_atlas_connection_string
PORT=5000

# Generate with: npm run generate-vapid  (from inside the server/ folder)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=you@example.com

# IMPORTANT: set this to your own IANA timezone so 6pm means YOUR 6pm,
# not the server's. Example for India:
TZ=Asia/Kolkata
